{
  "serviceMode": "mapgis-igs",
  "enabled": true,
  "serviceName": "MapGIS IGServer",
  "workspace": "shihua",
  "wms": {
    "url": "http://localhost:8080/geoserver/shihua/wms",
    "basinsLayer": "shihua:main_basins",
    "wellsLayer": "shihua:wells"
  },
