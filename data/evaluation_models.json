{
  "economicWorkflow": {
    "id": "africa-field-economic-evaluation",
    "name": "非洲油气田经济评价流程",
    "api": {
      "config": "/api/evaluation/economic/config",
      "run": "/api/evaluation/economic/run"
    },
    "stages": [
      { "id": "resource", "name": "资源基础", "scoreKey": "resourceScore" },
      { "id": "production", "name": "生产状态", "scoreKey": "productionScore" },
      { "id": "engineering", "name": "工程成本", "scoreKey": "engineeringScore" },
      { "id": "commercial", "name": "商业条件", "scoreKey": "commercialScore" },
      { "id": "result", "name": "评价结果", "scoreKey": "economicIndex" }
    ],
    "inputs": [
      "非洲油气田 CSV 明细",
      "非洲合同区块 MapGIS 服务",
      "非洲盆地 MapGIS 服务",
      "油气田表内井数、生产井、干井、显示井字段"
    ],
    "parameters": [
      "油价",
      "气价",
      "BOE 收入口径",
      "陆上/陆架/深水开发成本",
      "操作成本",
      "折现率",
      "评价年限",
      "地质风险",
      "税费权益扣减",
      "设施复用抵减"
    ]
  }
}
