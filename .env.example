# PostgreSQL/PostGIS
DATABASE_URL=postgresql://shihua:shihua_dev_password@localhost:5432/shihua
POSTGRES_DB=shihua
POSTGRES_USER=shihua
POSTGRES_PASSWORD=shihua_dev_password
POSTGRES_PORT=5432

# MinIO object storage
MINIO_ROOT_USER=shihua
MINIO_ROOT_PASSWORD=shihua_minio_password
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=shihua
MINIO_SECRET_KEY=shihua_minio_password
MINIO_BUCKET=shihua-source-data
MINIO_CONSOLE_PORT=9001

# Application behavior and external integration
PORT=5173
MIGRATION_FALLBACK=false
SHIHUA_SOURCE_ROOT=D:/replace-with-your-source-data-root
POSTGRES_DATA_DIR=./runtime-data/postgres
MINIO_DATA_DIR=./runtime-data/minio
# Set a token issued for the target deployment environment.
TDT_TOKEN=
